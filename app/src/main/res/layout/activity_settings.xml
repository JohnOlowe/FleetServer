<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/window_bg"
  android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/panel_bg"
    app:navigationIcon="@drawable/ic_chevron_left"
    app:title="@string/title_settings"
    app:titleTextColor="@color/text_primary" />

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingTop="12dp"
      android:paddingEnd="20dp"
      android:paddingBottom="32dp">

      <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/port_layout"
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/settings_port">

        <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/port_input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:inputType="number"
          android:maxLength="5"
          android:text="8080" />
      </com.google.android.material.textfield.TextInputLayout>

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_port_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/button_restart"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_restart" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/panel_border" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_autostart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_autostart"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_primary" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_follow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_follow"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_primary" />

      <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_trail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_trail"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_primary" />

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/panel_border" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_map_mode"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/text_primary" />

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/map_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:checkedButton="@+id/button_mode_osm"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/button_mode_osm"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/settings_mode_osm" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/button_mode_offline"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/settings_mode_offline" />
      </com.google.android.material.button.MaterialButtonToggleGroup>

      <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/panel_border" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_network"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="@color/text_primary" />

      <TextView
        android:id="@+id/network_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:text="-"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary" />

      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/settings_applied"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/text_secondary" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
