<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@color/panel_bg"
  android:orientation="vertical"
  android:paddingStart="20dp"
  android:paddingTop="12dp"
  android:paddingEnd="20dp"
  android:paddingBottom="20dp">

  <View
    android:layout_width="36dp"
    android:layout_height="4dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginBottom="14dp"
    android:alpha="0.4"
    android:background="@drawable/bg_pill" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/detail_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="esp32-01"
      android:textAppearance="?attr/textAppearanceTitleMedium"
      android:textColor="@color/text_primary" />

    <TextView
      android:id="@+id/detail_state"
      style="@style/FleetStatePill"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_state_pill"
      android:text="@string/state_operational" />
  </LinearLayout>

  <TextView
    android:id="@+id/detail_coords"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="6.524400, 3.379200"
    android:textAppearance="@style/FleetTextCoords"
    android:textSize="15sp" />

  <LinearLayout
    android:id="@+id/detail_rows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/button_center"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/button_center"
      app:icon="@drawable/ic_my_location" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/button_copy"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:text="@string/button_copy"
      app:icon="@drawable/ic_copy" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/button_clear_trail"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/button_clear_trail"
      app:icon="@drawable/ic_route" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/button_remove"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:text="@string/button_remove"
      app:icon="@drawable/ic_delete"
      app:iconTint="@color/state_gps_not_found" />
  </LinearLayout>
</LinearLayout>
